* text=auto eol=lf
*.png binary
*.jpg binary
*.glb binary
*.npz binary
*.blend binary
# Preserve all delivered asset-package bytes (including checksum JSON files).
exports/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
exports/**/*.obj binary
# Keep the checksum-bearing paper/demo package byte-identical after cloning.
docs/figures/showcase_hard_v02/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Texture-library manifests are pinned by their exact SHA-256 bytes.
materials/reference_rock_v01/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib vector exports retain generator formatting and checksum-bearing bytes.
exports/**/section_comparison.svg -diff -whitespace
# Published historical evidence includes hash-bound JSON and source snapshots.
outputs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
research_workspace/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
overleaf/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.pdf binary
*.zip binary
# Preserve archived log formatting, intentional Markdown breaks and official templates.
outputs/** -whitespace
